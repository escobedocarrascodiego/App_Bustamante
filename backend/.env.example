# Copiar a .env y completar con los valores reales.
# .env NO se commitea — solo este .env.example queda en el repo.

# --- Django ---
DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# --- SQL Server (Microsoft) ---
# Driver ODBC instalado en el equipo. En Windows tipico:
#   "ODBC Driver 17 for SQL Server" o "ODBC Driver 18 for SQL Server"
MSSQL_DRIVER=ODBC Driver 17 for SQL Server
MSSQL_USER=tu_usuario_sqlserver
MSSQL_PASSWORD=tu_password_sqlserver
MSSQL_PORT=1433

# --- Bases de datos ---
# default: BD propia del app (escritura: ciudadanos, tarjetas, sesiones, etc.)
DB_DEFAULT_NAME=dbbusta_app
DB_DEFAULT_HOST=127.0.0.1

# muni_db: SIAP - tributos / contribuyentes (SOLO LECTURA)
DB_MUNI_NAME=MuniJLByR
DB_MUNI_HOST=127.0.0.1

# tramites_db: SIAP - mesa de partes / expedientes (SOLO LECTURA, salvo
# IngresosExternos donde si se inserta via raw SQL)
DB_TRAMITES_NAME=dbControl
DB_TRAMITES_HOST=127.0.0.1
